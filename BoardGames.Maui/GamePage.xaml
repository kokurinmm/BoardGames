<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BoardGames.GamePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Игра">

    <Grid
        Padding="12"
        RowDefinitions="Auto, *, Auto"
        RowSpacing="12">

        <Label
            x:Name="StatusLabel"
            Grid.Row="0"
            FontSize="18"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center" />

        <Border
            x:Name="BoardHost"
            Grid.Row="1"
            Padding="8"
            StrokeThickness="2"
            SizeChanged="OnBoardHostSizeChanged">

            <GraphicsView
                x:Name="BoardGraphicsView"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

        </Border>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*"
            ColumnSpacing="12">

            <Button
                Grid.Column="0"
                Text="Новая игра"
                HeightRequest="48"
                CornerRadius="12"
                Clicked="OnNewGameClicked" />

            <Button
                Grid.Column="1"
                Text="Назад"
                HeightRequest="48"
                CornerRadius="12"
                Clicked="OnBackClicked" />

        </Grid>

    </Grid>
</ContentPage>